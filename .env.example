# PostgreSQL Production Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_resource_intelligence
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Runtime Settings
# Set TESTING=True to fallback to local SQLite test.db. Set to False for PostgreSQL production.
TESTING=False

# Backend CORS Configuration
# Must be a JSON array of allowed origin strings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:80"]

# Frontend Vite Client API Location (Required at build time or local runner)
VITE_API_BASE_URL=http://localhost:8000

# Authentication Configuration
JWT_SECRET=supersecretkeychangeinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123

